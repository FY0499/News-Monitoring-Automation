    {
      "parameters": {
        "jsCode": "// نجيب كل أخبار RSS من العقدة الأصلية (بغض النظر عن اتصالها المباشر)\nconst rssItems = $('RSS Read').all();\n\n// مخرجات هذه العقدة = كل الصفوف المنشورة سابقاً من Google Sheets\nconst seenRows = $input.all();\n\nconst seenLinks = new Set(\n  seenRows\n    .map(row => row.json && row.json.link)\n    .filter(link => !!link)\n);\n\n// نُبقي فقط الأخبار التي رابطها غير موجود مسبقاً\nconst newItems = rssItems.filter(item => !seenLinks.has(item.json.link));\n\nreturn newItems;"
      },
