    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=العنوان: {{ $json.title }}\n\nالمحتوى: {{ $json.content }}",
        "options": {
          "systemMessage": "أنت محرر أخبار محترف. لخص الخبر التالي بجملتين إلى ثلاث جمل بالعربية الفصحى، وحدد تصنيفاً مناسباً له (مثل: سياسة، اقتصاد، رياضة، ثقافة، تقنية، منوعات). أرجع ردّك بصيغة JSON صالحة فقط بدون أي نص إضافي أو علامات ```، وبالشكل التالي بالضبط:\n{\"category\": \"التصنيف\", \"summary\": \"الملخص\"}"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        896,
        80
      ],
      "id": "01fe35c6-f0af-41bd-bdac-7516d88669fb",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "jsCode": "// رد الـ AI Agent\nconst raw = $input.first().json.output || $input.first().json.text || '';\n\nlet parsed;\n\ntry {\n  const cleaned = raw\n    .replace(/```json/g, '')\n    .replace(/```/g, '')\n    .trim();\n\n  parsed = JSON.parse(cleaned);\n\n} catch (e) {\n  parsed = {\n    category: 'عام',\n    summary: raw.trim().slice(0, 300)\n  };\n}\n\n// نجيب الخبر الأصلي من الـ Node الموجودة قبل AI Agent\nconst original = $('Code in JavaScript').item.json;\n\nreturn [{\n  json: {\n    title: original.title || '',\n    link: original.link || '',\n    pubDate: original.pubDate || '',\n    category: parsed.category || 'عام',\n    summary: parsed.summary || '',\n    dateAdded: new Date().toISOString()\n  }\n}];"
      },
